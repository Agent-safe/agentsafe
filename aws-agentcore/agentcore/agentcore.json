{
  "$schema": "https://schema.agentcore.aws.dev/v1/agentcore.json",
  "name": "AgentSafeRuntime",
  "version": 1,
  "managedBy": "CDK",
  "tags": {
    "agentcore:created-by": "agentcore-cli",
    "agentcore:project-name": "AgentSafeRuntime"
  },
  "runtimes": [
    {
      "name": "AgentSafeOrchestrator",
      "build": "CodeZip",
      "entrypoint": "main.py",
      "codeLocation": "app/AgentSafeOrchestrator",
      "runtimeVersion": "PYTHON_3_13",
      "networkMode": "PUBLIC",
      "protocol": "HTTP",
      "envVars": [
        { "name": "AWS_REGION", "value": "eu-north-1" },
        { "name": "BEDROCK_MODEL_CHAIN", "value": "eu.anthropic.claude-sonnet-5-5,eu.anthropic.claude-haiku-5-5,global.anthropic.claude-sonnet-5-5,eu.mistral.pixtral-large-2502-v1:0" },
        { "name": "BEDROCK_EMBEDDING_MODEL_ID", "value": "amazon.titan-embed-text-v2:0" },
        { "name": "AGENTSAFE_OPENSEARCH_ENDPOINT", "value": "https://0xlz5f5o1g6t87zj23o6.aoss.eu-north-1.on.aws" },
        { "name": "AGENTSAFE_OPENSEARCH_INDEX", "value": "agentsafe-policy-guidance" }
      ],
      "lifecycleConfiguration": {
        "idleRuntimeSessionTimeout": 300,
        "maxLifetime": 3600
      }
    }
  ],
  "memories": [],
  "knowledgeBases": [],
  "credentials": [],
  "evaluators": [],
  "onlineEvalConfigs": [],
  "agentCoreGateways": [],
  "policyEngines": [],
  "configBundles": [],
  "abTests": [],
  "harnesses": [],
  "datasets": [],
  "capacityProviders": [],
  "payments": []
}
